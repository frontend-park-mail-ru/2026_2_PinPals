# Режим Vite dev-сервера: backend (Go) или mock (server.dev.js).
API_MODE=backend
# Локальный запуск Go backend на хостовой машине.
AUTH_API_TARGET=http://localhost:8001
PIN_API_TARGET=http://localhost:8002
USER_API_TARGET=http://localhost:8003

# Для mock-режима задайте API_MODE=mock и при необходимости API_TARGET.
# API_MODE=mock
# API_TARGET=http://localhost:3001

# Production Express server использует те же AUTH_API_TARGET,
# PIN_API_TARGET и USER_API_TARGET. В Docker они должны указывать
# на имена сервисов в общей Docker-сети.
PORT=8080
