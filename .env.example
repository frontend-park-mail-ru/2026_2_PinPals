# Общий HTTP-порт frontend server.js (production preview / global start).
PORT=3000

# Режим API: mock или backend.
# Mock работает в двух вариантах запуска: через Vite dev proxy и через server.js.
API_MODE=mock
API_TARGET=http://127.0.0.1:3001
MOCK_API_PORT=3001

# Для подключения реальных Go-сервисов переключите API_MODE=backend
# и заполните адреса ниже.
# API_MODE=backend
AUTH_API_TARGET=http://localhost:8001
PIN_API_TARGET=http://localhost:8002
USER_API_TARGET=http://localhost:8003

# Дополнительные настройки мок-сервера.
AUTH_TOKEN_TTL=24h
JWT_SECRET=local-dev-only-change-this-secret
UPLOAD_DIR=./uploads
