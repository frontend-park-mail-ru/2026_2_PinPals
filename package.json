{
  "name": "pickking",
  "version": "1.0.0",
  "private": true,
  "description": "PicKing frontend and API proxy",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "dev:server": "node --env-file-if-exists=.env server.dev.js",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server.js",
    "lint": "eslint \"src/**/*.{js,ts}\" server.js server.dev.js vite.config.js eslint.config.js",
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "dev:mock": "node --env-file-if-exists=.env server.dev.js",
    "dev:frontend": "vite"
  },
  "dependencies": {
    "express": "^5.3.0",
    "handlebars": "^4.7.10",
    "http-proxy-middleware": "^4.2.1"
  },
  "devDependencies": {
    "@cpulvermacher/vite-plugin-handlebars": "^1.5.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "glob": "^14.0.3",
    "globals": "^17.14.0",
    "vite": "^8.3.5",
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.0",
    "sass": "^1.93.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.0"
  }
}
