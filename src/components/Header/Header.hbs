<header class="home-header">
    <div class="header-left-group">
        {{#if showBack}}
            <a class="header-back" href="{{backUrl}}" data-router-back="{{backFallback}}" aria-label="Назад" title="Назад">
                <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
            </a>
        {{/if}}
        <a class="header-left" href="/home">
            {{#if isAuth}}
                <img src="/img/logo_reg.png" alt="Logo" class="logo-img-small">
            {{else}}
                <img src="/img/logo_no_reg.png" alt="Logo" class="logo-img-small">
            {{/if}}
            <span class="logo-text-small">PicKing</span>
        </a>
    </div>

    <div class="header-center"></div>

    <div class="header-right">
        {{#if isAuth}}
            <div class="user-menu-wrapper">
                <div class="user-avatar" title="Профиль">
                    <img src="{{userAvatarUrl}}" alt="">
                </div>
                <div class="user-dropdown">
                    <div class="user-name">{{userName}}</div>
                    <a class="btn-profile-menu" href="/profile">Профиль</a>
                    <button class="btn-logout" id="logoutBtn" type="button">Выйти</button>
                </div>
            </div>
        {{else}}
            <a class="btn-header btn-login-header" href="/login" style="display: flex; align-items: center; text-decoration: none;">Вход</a>
            <a class="btn-header btn-register-header" href="/signup" style="display: flex; align-items: center; text-decoration: none;">Регистрация</a>
        {{/if}}
    </div>
</header>
