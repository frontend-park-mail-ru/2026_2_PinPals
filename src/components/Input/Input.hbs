<div class="input-wrapper {{#if error}}input-wrapper--error{{/if}}">
    <label for="{{name}}">{{label}}</label>

    <div class="input-field-container">
        <input type="{{type}}" id="{{name}}" name="{{name}}" placeholder="{{placeholder}}">
        {{#if isPassword}}
            <button type="button" class="eye-icon-img" aria-label="Показать пароль" aria-pressed="false">
                <svg class="icon eye-open" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>
                </svg>
                <svg class="icon eye-closed" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M3 3l18 18"/>
                    <path d="M10.6 5.1A10.7 10.7 0 0 1 12 5c6.4 0 10 7 10 7a17.5 17.5 0 0 1-3.2 4.2M6.6 6.6C3.7 8.4 2 12 2 12s3.6 7 10 7c1.7 0 3.2-.4 4.5-1"/>
                </svg>
            </button>
        {{/if}}
    </div>

    <span class="error-msg">{{error}}</span>
</div>
