<div class="profile-page">
    <main class="profile-main">
        <section class="profile-heading-row">
            <h1 class="profile-title">Ваши сохраненные идеи</h1>

            <div class="profile-user-card">
                {{#if userAvatarUrl}}
                    <img class="profile-avatar" src="{{userAvatarUrl}}" alt="Аватар пользователя">
                {{else}}
                    <div class="profile-avatar profile-avatar--placeholder" aria-hidden="true">{{userInitial}}</div>
                {{/if}}
                <div class="profile-user-info">
                    <span class="profile-user-name">{{userName}}</span>
                    <span class="profile-followers">{{followersLabel}}</span>
                </div>
            </div>
        </section>

        <section class="profile-toolbar">
            <nav class="profile-tabs" aria-label="Сохранённые идеи">
                <a
                        class="profile-tab {{#if isPinsTab}}is-active{{/if}}"
                        href="/profile/pins"
                        {{#if isPinsTab}}aria-current="page"{{/if}}
                >Пины</a>
                <a
                        class="profile-tab {{#if isBoardsTab}}is-active{{/if}}"
                        href="/profile/boards"
                        {{#if isBoardsTab}}aria-current="page"{{/if}}
                >Доски</a>
            </nav>

            <button class="profile-create-button" id="profileActionButton" type="button">
                {{actionText}}
            </button>
        </section>

        {{#if isPinsTab}}
            <section class="profile-content" aria-label="Сохранённые пины">
                <div class="profile-pins-grid" id="profilePinsGrid"></div>
                <p class="profile-content-state" id="profileContentState" role="status">Загружаем пины…</p>
            </section>
        {{else}}
            <section class="profile-content" aria-label="Сохранённые доски">
                <div class="profile-boards-grid" id="profileBoardsGrid"></div>
                <p class="profile-content-state" id="profileContentState" role="status" hidden></p>
            </section>
        {{/if}}
    </main>
</div>
